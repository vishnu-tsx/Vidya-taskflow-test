{
  "name": "taskflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src ./vite.config.ts",
    "lint:fix": "biome check --write ./src ./vite.config.ts",
    "format": "biome format --write ./src ./vite.config.ts",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false ./src ./vite.config.ts",
    "spell": "cspell \"src/**\" --no-progress",
    "test": "vitest"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "ag-grid-community": "^35.0.1",
    "ag-grid-enterprise": "^35.0.1",
    "ag-grid-react": "^35.0.1",
    "axios": "^1.13.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cspell": "^9.6.2",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}
