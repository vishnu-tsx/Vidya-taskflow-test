{
  "$schema": "https://biomejs.dev/schemas/2.3.13/schema.json",

  "assist": {
    "enabled": true
  },

  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },

  "formatter": {
    "enabled": true
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5"
    }
  },

  "files": {
    "includes": ["src/**/*.{js,ts,jsx,tsx}"],
    "experimentalScannerIgnores": ["node_modules/**", "dist/**"]
  }
}
